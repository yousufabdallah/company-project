# Postgres connection string used by Prisma.
# Docker compose: host must be the `db` service name, and user/password/database
# must match the POSTGRES_* values below.
DATABASE_URL="postgresql://elmanara:change-me@db:5432/elmanara?schema=public"

# Credentials the postgres container is initialised with.
POSTGRES_USER=elmanara
POSTGRES_PASSWORD=change-me
POSTGRES_DB=elmanara

SESSION_SECRET=
NODE_ENV=production
PORT=3745

# Accounts created by prisma/bootstrap.ts on every `docker compose up`.
# These passwords apply when an account is first created. Passwords changed
# in the app survive redeploys; set BOOTSTRAP_RESET_PASSWORDS=1 to force
# accounts back to the values below (e.g. to recover a lost login).
SUPER_ADMIN_EMAIL=admin@autosaas.com
SUPER_ADMIN_PASSWORD=change-me
OWNER_EMAIL=owner@almanara.om
OWNER_PASSWORD=change-me
WORKSHOP_NAME="Al-Manara Auto Service"

# Uncomment only to force accounts back to the passwords above on the next up.
# BOOTSTRAP_RESET_PASSWORDS=1
