// Auto Workshop SaaS — Multi-tenant data model
// Designed to mirror a Laravel/MySQL SaaS schema but running on SQLite for the preview.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─── Tenancy & Access ────────────────────────────────────────────────

model Tenant {
  id              String   @id @default(cuid())
  name            String
  logo            String?
  stamp           String?
  address         String?
  phone           String?
  whatsapp        String?
  email           String?
  crNumber        String? // commercial registration
  taxNumber       String?
  currency        String   @default("OMR")
  taxEnabled      Boolean  @default(true)
  taxPercent      Float    @default(5)
  invoicePrefix   String   @default("INV-")
  jobCardPrefix   String   @default("JC-")
  estimatePrefix  String   @default("EST-")
  workingHours    String?  @default("Sat-Thu, 8:00 - 18:00")
  invoiceFooter   String?
  terms           String?
  status          String   @default("active") // active | suspended | trial
  plan            String   @default("Professional")
  planId          String?
  planRecord      Plan?    @relation(fields: [planId], references: [id])
  subscriptionStatus  String   @default("trial") // trial | active | past_due | cancelled
  subscriptionExpiry  DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  users           User[]
  branches        Branch[]
  customers       Customer[]
  vehicles        Vehicle[]
  services        Service[]
  parts           Part[]
  categories      Category[]
  suppliers       Supplier[]
  warehouses      Warehouse[]
  estimates       Estimate[]
  jobCards        JobCard[]
  invoices        Invoice[]
  payments        Payment[]
  expenses        Expense[]
  appointments    Appointment[]
  purchases       Purchase[]
  warranties      Warranty[]
  auditLogs       AuditLog[]
}

model User {
  id         String    @id @default(cuid())
  tenantId   String
  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name       String
  email      String     @unique
  password   String
  role       String     @default("manager") // super_admin | owner | manager | advisor | technician | accountant | inventory
  phone      String?
  active     Boolean   @default(true)
  lastLoginAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  jobCardsAssigned   JobCard[]  @relation("TechJobs")
  jobCardsAdvised    JobCard[]  @relation("AdvisorJobs")
  appointmentsTech   Appointment[]
  auditLogs          AuditLog[]
  branchesManaged    Branch[]
}

model Branch {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  address   String?
  phone     String?
  managerId String?
  manager   User?    @relation(fields: [managerId], references: [id])
  createdAt DateTime @default(now())

  warehouses Warehouse[]
  expenses   Expense[]
}

// ─── CRM & Vehicles ───────────────────────────────────────────────────

model Customer {
  id         String   @id @default(cuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  code       String   @default("CUST-0001")
  name       String
  mobile     String
  whatsapp   String?
  email      String?
  address    String?
  type       String   @default("individual") // individual | corporate
  notes      String?
  balance    Float    @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([tenantId, mobile])
  @@index([tenantId, name])

  vehicles     Vehicle[]
  jobCards     JobCard[]
  invoices     Invoice[]
  payments     Payment[]
  appointments Appointment[]
  estimates    Estimate[]
}

model Vehicle {
  id           String   @id @default(cuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customerId   String
  customer     Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  plateNumber  String
  vin          String?
  make         String
  model        String
  year         Int?
  color        String?
  engineType   String?
  fuelType     String?
  transmission String?
  mileage      Int      @default(0)
  photo        String?
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([tenantId, plateNumber])
  @@index([tenantId, vin])

  inspections  VehicleInspection[]
  jobCards     JobCard[]
  appointments Appointment[]
  estimates    Estimate[]
  invoices     Invoice[]
}

model VehicleInspection {
  id         String   @id @default(cuid())
  tenantId   String
  vehicleId  String
  vehicle    Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  jobCardId  String?
  jobCard    JobCard? @relation(fields: [jobCardId], references: [id])
  advisorId  String?
  date       DateTime @default(now())
  items      String   @default("{}") // JSON: { engine: "good", brakes: "attention", ... }
  notes      String?
  photos     String?  // JSON array of urls
  createdAt  DateTime @default(now())

  @@index([vehicleId])
}

// ─── Service Catalog & Inventory ──────────────────────────────────────

model Category {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  type      String   @default("part") // part | service | expense
  createdAt DateTime @default(now())

  parts Part[]
}

model Service {
  id             String   @id @default(cuid())
  tenantId       String
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  code           String
  name           String
  description    String?
  durationHours  Float    @default(1)
  laborCost      Float    @default(0)
  price          Float    @default(0)
  warrantyMonths Int      @default(0)
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())

  jobCardServices JobCardService[]
  appointments    Appointment[]
}

model Part {
  id            String    @id @default(cuid())
  tenantId      String
  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sku           String
  barcode       String?
  name          String
  nameAr        String?
  categoryId    String?
  category      Category? @relation(fields: [categoryId], references: [id])
  brand         String?
  supplierId    String?
  supplier      Supplier?  @relation(fields: [supplierId], references: [id])
  costPrice     Float     @default(0)
  sellingPrice  Float     @default(0)
  quantity      Int       @default(0)
  minStock      Int       @default(5)
  maxStock      Int       @default(100)
  location      String?
  warrantyMonths Int      @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([tenantId, sku])
  @@index([tenantId, barcode])

  stockMovements  StockMovement[]
  jobCardParts    JobCardPart[]
  purchaseItems   PurchaseItem[]
}

model Supplier {
  id           String   @id @default(cuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name         String
  company      String?
  phone        String?
  whatsapp     String?
  email        String?
  address      String?
  taxNumber    String?
  paymentTerms String?
  balance      Float    @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  parts     Part[]
  purchases Purchase[]
}

model Warehouse {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  branchId  String?
  branch    Branch?  @relation(fields: [branchId], references: [id])
  location  String?
  createdAt DateTime @default(now())

  stockMovements StockMovement[]
  purchases      Purchase[]
}

model StockMovement {
  id          String   @id @default(cuid())
  tenantId    String
  partId      String
  part        Part     @relation(fields: [partId], references: [id], onDelete: Cascade)
  warehouseId String?
  warehouse   Warehouse? @relation(fields: [warehouseId], references: [id])
  type        String   // in | out | adjust | transfer | return | damaged | reserved
  quantity    Int
  refType     String?  // job_card | purchase | adjustment
  refId       String?
  note        String?
  createdAt   DateTime @default(now())
  createdBy   String?

  @@index([partId])
}

// ─── Appointments, Estimates, Job Cards ──────────────────────────────

model Appointment {
  id           String   @id @default(cuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customerId   String
  customer     Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  vehicleId    String?
  vehicle      Vehicle? @relation(fields: [vehicleId], references: [id])
  serviceId    String?
  service      Service? @relation(fields: [serviceId], references: [id])
  date         DateTime
  time         String
  technicianId String?
  technician   User?    @relation(fields: [technicianId], references: [id])
  status       String   @default("scheduled") // scheduled | confirmed | arrived | cancelled | no_show | completed
  notes        String?
  createdAt    DateTime @default(now())

  @@index([tenantId, date])
}

model Estimate {
  id           String   @id @default(cuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  code         String
  customerId   String
  customer     Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  vehicleId    String?
  vehicle      Vehicle? @relation(fields: [vehicleId], references: [id])
  jobCardId    String?
  date         DateTime @default(now())
  laborTotal   Float    @default(0)
  partsTotal   Float    @default(0)
  discount     Float    @default(0)
  tax          Float    @default(0)
  grandTotal   Float    @default(0)
  status       String   @default("pending") // pending | approved | rejected
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  items EstimateItem[]
}

model EstimateItem {
  id          String  @id @default(cuid())
  estimateId  String
  estimate    Estimate @relation(fields: [estimateId], references: [id], onDelete: Cascade)
  type        String  // service | part
  name        String
  description String?
  quantity    Float   @default(1)
  unitPrice   Float   @default(0)
  discount    Float   @default(0)
  total       Float   @default(0)
}

model JobCard {
  id                 String   @id @default(cuid())
  tenantId           String
  tenant             Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  code               String
  customerId         String
  customer           Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  vehicleId          String
  vehicle            Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  mileage            Int      @default(0)
  complaint          String
  diagnosis          String?
  estimatedCompletion DateTime?
  technicianId       String?
  technician         User?    @relation("TechJobs", fields: [technicianId], references: [id])
  advisorId          String?
  advisor            User?    @relation("AdvisorJobs", fields: [advisorId], references: [id])
  priority           String   @default("normal") // low | normal | high | urgent
  status             String   @default("draft")
  notes              String?
  photos             String?  // JSON array
  laborTotal         Float    @default(0)
  partsTotal         Float    @default(0)
  discount           Float    @default(0)
  tax                Float    @default(0)
  grandTotal         Float    @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([tenantId, status])
  @@index([tenantId, code])

  parts     JobCardPart[]
  services  JobCardService[]
  inspections VehicleInspection[]
  invoice   Invoice?
  warranties Warranty[]
}

model JobCardPart {
  id         String  @id @default(cuid())
  jobCardId  String
  jobCard    JobCard @relation(fields: [jobCardId], references: [id], onDelete: Cascade)
  partId     String
  part       Part    @relation(fields: [partId], references: [id])
  quantity   Int     @default(1)
  unitPrice  Float   @default(0)
  discount   Float   @default(0)
  total      Float   @default(0)
  status     String  @default("reserved") // reserved | used
}

model JobCardService {
  id         String  @id @default(cuid())
  jobCardId  String
  jobCard    JobCard @relation(fields: [jobCardId], references: [id], onDelete: Cascade)
  serviceId  String?
  service    Service? @relation(fields: [serviceId], references: [id])
  name       String
  hours      Float   @default(1)
  laborPrice Float   @default(0)
  discount   Float   @default(0)
  total      Float   @default(0)
}

// ─── Invoicing, Payments, Purchases, Expenses ─────────────────────────

model Invoice {
  id           String   @id @default(cuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  code         String
  customerId   String
  customer     Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  vehicleId    String?
  vehicle      Vehicle? @relation(fields: [vehicleId], references: [id])
  jobCardId    String?  @unique
  jobCard      JobCard? @relation(fields: [jobCardId], references: [id])
  date         DateTime @default(now())
  dueDate      DateTime?
  laborTotal   Float    @default(0)
  partsTotal   Float    @default(0)
  discount     Float    @default(0)
  tax          Float    @default(0)
  grandTotal   Float    @default(0)
  paidAmount   Float    @default(0)
  status       String   @default("unpaid") // unpaid | partial | paid | refunded
  notes        String?
  createdAt    DateTime @default(now())

  @@index([tenantId, code])
  @@index([tenantId, status])

  items    InvoiceItem[]
  payments Payment[]
}

model InvoiceItem {
  id          String  @id @default(cuid())
  invoiceId   String
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  type        String // service | part
  name        String
  quantity    Float  @default(1)
  unitPrice   Float  @default(0)
  discount    Float  @default(0)
  total       Float  @default(0)
}

model Payment {
  id         String   @id @default(cuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoiceId  String?
  invoice    Invoice? @relation(fields: [invoiceId], references: [id])
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  amount     Float
  method     String   @default("cash") // cash | card | bank | other
  date       DateTime @default(now())
  reference  String?
  note       String?
  createdAt  DateTime @default(now())

  @@index([tenantId, date])
}

model Purchase {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  code        String
  supplierId  String
  supplier    Supplier @relation(fields: [supplierId], references: [id])
  warehouseId String?
  warehouse   Warehouse? @relation(fields: [warehouseId], references: [id])
  date        DateTime @default(now())
  status      String   @default("draft") // draft | received | invoiced | paid
  total       Float    @default(0)
  tax         Float    @default(0)
  grandTotal  Float    @default(0)
  paid        Float    @default(0)
  createdAt   DateTime @default(now())

  items PurchaseItem[]
}

model PurchaseItem {
  id         String   @id @default(cuid())
  purchaseId String
  purchase   Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  partId     String
  part       Part     @relation(fields: [partId], references: [id])
  quantity   Int      @default(1)
  unitCost   Float    @default(0)
  total      Float    @default(0)
}

model Expense {
  id         String   @id @default(cuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branchId   String?
  branch     Branch?  @relation(fields: [branchId], references: [id])
  category   String   // rent | electricity | salaries | tools | transport | maintenance | marketing | other
  amount     Float
  date       DateTime @default(now())
  method     String   @default("cash")
  description String?
  createdAt  DateTime @default(now())

  @@index([tenantId, date])
}

model Warranty {
  id            String   @id @default(cuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  type          String   // part | service | repair
  refId         String
  jobCardId     String?
  jobCard      JobCard?  @relation(fields: [jobCardId], references: [id])
  partId        String?
  serviceId     String?
  periodMonths  Int
  startDate     DateTime @default(now())
  expiryDate    DateTime
  terms         String?
  createdAt     DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  module    String
  record    String?
  ip        String?
  createdAt DateTime @default(now())

  @@index([tenantId, createdAt])
}

// ─── SaaS Plans & Platform Settings ───────────────────────────────────

model Plan {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  price       Float    @default(0) // OMR / month
  maxBranches Int      @default(1) // -1 = unlimited
  maxUsers    Int      @default(3) // -1 = unlimited
  maxJobCards Int      @default(500) // per month, -1 = unlimited
  features    String   @default("[]") // JSON array of feature strings
  active      Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenants Tenant[]
}

model PlatformSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}
